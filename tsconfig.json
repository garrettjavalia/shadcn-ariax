{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@button": [
        "./registry/ariax/ui/button.tsx"
      ],
      "@customizations": [
        "./stories/customizations.ts"
      ],
      "@separator": [
        "./registry/ariax/ui/separator.tsx"
      ],
      "@skeleton": [
        "./registry/ariax/ui/skeleton.tsx"
      ],
      "@skeleton-customizations": [
        "./stories/skeleton-customizations.ts"
      ],
      "@reference/*": [
        "./generated/reference/aria-nova/*"
      ],
      "@table": [
        "./registry/ariax/ui/table.tsx"
      ],
      "@table-customizations": [
        "./stories/table-customizations.ts"
      ]
    }
  },
  "include": [
    ".storybook",
    "stories",
    "registry",
    "tests",
    "playwright.config.ts",
    "scripts",
    "reference",
    "generated/reference",
    "tests/types"
  ]
}
