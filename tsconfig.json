{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@card-customizations": [
        "./stories/card-customizations.ts"
      ],
      "@card": [
        "./registry/ariax/ui/card.tsx"
      ],
      "@button": [
        "./registry/ariax/ui/button.tsx"
      ],
      "@customizations": [
        "./stories/customizations.ts"
      ],
      "@separator": [
        "./registry/ariax/ui/separator.tsx"
      ],
      "@skeleton": [
        "./registry/ariax/ui/skeleton.tsx"
      ],
      "@skeleton-customizations": [
        "./stories/skeleton-customizations.ts"
      ],
      "@reference/*": [
        "./generated/reference/aria-nova/*"
      ],
      "@badge": [
        "./registry/ariax/ui/badge.tsx"
      ],
      "@badge-customizations": [
        "./stories/badge-customizations.ts"
      ],
      "@alert": [
        "./registry/ariax/ui/alert.tsx"
      ],
      "@alert-customizations": [
        "./stories/alert-customizations.ts"
      ],
      "@aspect-ratio": [
        "./registry/ariax/ui/aspect-ratio.tsx"
      ],
      "@aspect-customizations": [
        "./stories/aspect-customizations.ts"
      ],
      "@label": [
        "./registry/ariax/ui/label.tsx"
      ],
      "@input": [
        "./registry/ariax/ui/input.tsx"
      ],
      "@input-customizations": [
        "./stories/input-customizations.ts"
      ],
      "@checkbox": [
        "./registry/ariax/ui/checkbox.tsx"
      ],
      "@textarea": [
        "./registry/ariax/ui/textarea.tsx"
      ],
      "@textarea-customizations": [
        "./stories/textarea-customizations.ts"
      ],
      "@field": [
        "./registry/ariax/ui/field.tsx"
      ],
      "@input-group": [
        "./registry/ariax/ui/input-group.tsx"
      ],
      "@input-group-customizations": [
        "./stories/input-group-customizations.ts"
      ],
      "@table": [
        "./registry/ariax/ui/table.tsx"
      ],
      "@table-customizations": [
        "./stories/table-customizations.ts"
      ],
      "@kbd": [
        "./registry/ariax/ui/kbd.tsx"
      ],
      "@kbd-customizations": [
        "./stories/kbd-customizations.ts"
      ]
    }
  },
  "include": [
    ".storybook",
    "stories",
    "registry",
    "tests",
    "playwright.config.ts",
    "scripts",
    "reference",
    "generated/reference",
    "tests/types"
  ],
  "exclude": [
    "generated/reference/**/source/**"
  ]
}
